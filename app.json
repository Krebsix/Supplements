{
  "expo": {
    "name": "MySuplea",
    "slug": "mysuplea",
    "version": "1.0.0",
    "scheme": "mysuplea",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1c4f5c"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.indoohome.mysuplea",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Die Kamera wird nur genutzt, um Etiketten von Nahrungsergänzungsmitteln zu fotografieren oder ihren Barcode zu lesen. Es findet keine Aufnahme ohne dein aktives Auslösen statt.",
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": [
          "de",
          "en"
        ],
        "CFBundleDevelopmentRegion": "de"
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.indoohome.mysuplea",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1c4f5c"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Die Kamera wird nur genutzt, um Etiketten von Nahrungsergänzungsmitteln zu fotografieren oder ihren Barcode zu lesen.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "einnahme-erinnerungen"
        }
      ],
      "expo-secure-store",
      "expo-font"
    ]
  }
}
