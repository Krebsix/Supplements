---
/**
 * Bericht fuer die Sprechstunde: Text plus eine Karte, die wie der
 * Export-Screen der App die waehlbaren Abschnitte zeigt.
 */
import Icon from './Icon.astro';
import Section from './Section.astro';
import { getDictionary, type Locale } from '../i18n/index.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

<Section id="report" eyebrow={t.report.eyebrow} title={t.report.title}>
  <div class="report">
    <aside class="card report__preview" aria-hidden="true">
      <div class="report__head">
        <span class="icon-tile">
          <Icon name="file-text" />
        </span>
      </div>
      <ul>
        {t.report.sections.map((section) => (
          <li>
            <span class="report__check">
              <Icon name="check" size={14} strokeWidth={2.5} />
            </span>
            <span>{section}</span>
          </li>
        ))}
      </ul>
    </aside>
    <p class="report__body">{t.report.body}</p>
  </div>
</Section>

<style>
  .report {
    display: grid;
    gap: 24px;
    align-items: center;
  }
  .report__preview {
    padding: 28px;
  }
  .report__preview ul {
    margin-top: 18px;
    display: grid;
    gap: 10px;
  }
  .report__preview li {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--ink);
    font-weight: 500;
    background: var(--canvas);
    border-radius: var(--radius-md);
    padding: 12px 14px;
  }
  .report__check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: var(--accent);
    color: var(--surface);
  }
  .report__body {
    max-width: 52ch;
    font-size: clamp(18px, 1.6vw, 21px);
  }
  @media (min-width: 900px) {
    .report {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      gap: 56px;
    }
  }
</style>
