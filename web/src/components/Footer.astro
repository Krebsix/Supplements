---
/**
 * Fusszeile: Navy, Mono-Schrift, Betreiberin, Pflichtlinks (Rechtsseiten
 * zweisprachig, Anker springt zur passenden Sprache), ODbL-Hinweis.
 */
import { CONTACT_EMAIL } from '../config.ts';
import { getDictionary, localePath, type Locale } from '../i18n/index.ts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDictionary(locale);
const anchor = `#${locale}`;
---

<footer class="footer">
  <div class="container footer__inner">
    <span>{t.footer.madeBy}</span>
    <nav class="footer__links" aria-label="Legal">
      <a href={`/datenschutz/${anchor}`}>{t.footer.privacy}</a>
      <a href={`/impressum/${anchor}`}>{t.footer.imprint}</a>
      <a href={`/nutzung/${anchor}`}>{t.footer.terms}</a>
      <a href={localePath(locale, '/support/')}>{t.footer.support}</a>
      <a href={localePath(locale, '/konto-loeschen/')}>{t.footer.deletion}</a>
      <a href={`mailto:${CONTACT_EMAIL}`}>{t.footer.contact}</a>
    </nav>
    <span>{t.footer.odbl}</span>
  </div>
</footer>

<style>
  .footer {
    background: var(--navy);
    color: var(--onnavy-faintest);
    padding: 0 0 48px;
  }
  .footer__inner {
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding-top: 32px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }
  .footer__links a {
    color: var(--onnavy-faint);
  }
  .footer__links a:hover {
    color: #ffffff;
  }
</style>
