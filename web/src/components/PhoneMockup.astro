---
/**
 * iPhone-Mockup: Tagessummen-Karte mit Obergrenzen-Balken plus zwei
 * Slot-Eintraege. Label-Text geprueft gegen die echte App
 * (i18n/de/dashboard.js: "Dokumentiert" / "Offen", siehe
 * launch/landing-page-claims-verification.md, Claim 8).
 */
import { getDictionary, type Locale } from '../i18n/index.ts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDictionary(locale);
---

<div class="phone" role="img" aria-label={t.mockup.aria}>
  <div class="phone__frame">
    <div class="phone__screen">
      <div class="phone__statusbar" aria-hidden="true">
        <span>9:41</span>
        <span class="phone__notch"></span>
        <span class="phone__signal">▂▄▆</span>
      </div>
      <div class="phone__content">
        <div class="phone__date">{t.mockup.date}</div>
        <div class="phone__title">{t.mockup.title}</div>

        <div class="card sums">
          <div class="sums__head">
            <span class="sums__title">{t.mockup.sumsTitle}</span>
            <span class="sums__sub">{t.mockup.sumsSub}</span>
          </div>
          {t.mockup.rows.map((row) => (
            <div class="sums__row">
              <div class="sums__line">
                <span class="sums__name">{row.name}</span>
                <span class:list={['sums__amount', `sums__amount--${row.tone}`]}>{row.amount}</span>
              </div>
              <div class="sums__bar">
                <div class:list={[`sums__bar-fill`, `sums__bar-fill--${row.tone}`]} style={`width:${row.pct}%`}></div>
              </div>
              <div class="sums__limit">
                {t.mockup.limitLabel} {row.limit}
              </div>
            </div>
          ))}
        </div>

        <div class="card slots">
          <div class="slots__row slots__row--border">
            <div>
              <div class="slots__name">{t.mockup.item1Name}</div>
              <div class="slots__dose">{t.mockup.item1Dose}</div>
            </div>
            <span class="slots__pill slots__pill--done">{t.mockup.item1State}</span>
          </div>
          <div class="slots__row">
            <div>
              <div class="slots__name">{t.mockup.item2Name}</div>
              <div class="slots__dose">{t.mockup.item2Dose}</div>
            </div>
            <span class="slots__pill slots__pill--open">{t.mockup.item2State}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .phone {
    width: 320px;
    max-width: 100%;
    margin: 0 auto;
  }
  .phone__frame {
    background: var(--navy);
    border-radius: 44px 44px 0 0;
    padding: 9px 9px 0;
    box-shadow: 0 -20px 80px -30px rgba(11, 34, 57, 0.4);
  }
  .phone__screen {
    background: #f2f2f7;
    border-radius: 36px 36px 0 0;
    overflow: hidden;
  }
  .phone__statusbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 13px 24px 5px;
    font-size: 12px;
    font-weight: 600;
    color: var(--ink);
  }
  .phone__notch {
    width: 74px;
    height: 20px;
    background: var(--navy);
    border-radius: var(--radius-pill);
  }
  .phone__signal {
    letter-spacing: 1px;
  }
  .phone__content {
    padding: 12px 16px 16px;
  }
  .phone__date {
    font-size: 11px;
    color: var(--ink-faintest);
    font-weight: 500;
  }
  .phone__title {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-top: 1px;
  }
  .phone .card {
    background: #ffffff;
    border-radius: 16px;
    padding: 14px 16px;
    margin-top: 12px;
    box-shadow: 0 4px 16px -8px rgba(11, 34, 57, 0.12);
  }
  .sums__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 10px;
  }
  .sums__title {
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
  }
  .sums__sub {
    font-size: 10px;
    color: var(--ink-faintest);
  }
  .sums__row {
    margin-bottom: 10px;
  }
  .sums__row:last-child {
    margin-bottom: 0;
  }
  .sums__line {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    margin-bottom: 4px;
  }
  .sums__name {
    font-weight: 600;
    color: var(--ink);
  }
  .sums__amount {
    font-weight: 700;
    font-family: var(--font-mono);
  }
  .sums__amount--caution {
    color: var(--status-caution);
  }
  .sums__amount--affirm {
    color: var(--status-affirm);
  }
  .sums__bar {
    height: 5px;
    background: #e8ecf2;
    border-radius: var(--radius-pill);
    overflow: hidden;
  }
  .sums__bar-fill {
    height: 100%;
    border-radius: var(--radius-pill);
  }
  .sums__bar-fill--caution {
    background: var(--status-caution);
  }
  .sums__bar-fill--affirm {
    background: var(--status-affirm);
  }
  .sums__limit {
    font-size: 10px;
    color: var(--ink-faintest);
    margin-top: 3px;
    font-family: var(--font-mono);
  }
  .slots {
    margin-top: 10px;
  }
  .slots__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 0;
  }
  .slots__row--border {
    border-bottom: 1px solid #f0f2f6;
    padding-top: 0;
  }
  .slots__name {
    font-size: 12px;
    font-weight: 600;
    color: var(--ink);
  }
  .slots__dose {
    font-size: 10px;
    color: var(--ink-faintest);
  }
  .slots__pill {
    font-size: 10px;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: var(--radius-pill);
  }
  .slots__pill--done {
    color: var(--status-affirm);
    background: rgba(30, 142, 90, 0.1);
  }
  .slots__pill--open {
    color: #4c6076;
    background: rgba(11, 34, 57, 0.06);
  }
</style>
