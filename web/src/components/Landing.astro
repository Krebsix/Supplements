---
/**
 * Die Landingpage, Redesign "Evidenz-Dossier" (design_handoff_mysuplea_landing/,
 * 2026-08-30). Beide Sprachseiten rendern diese Komponente mit ihrem
 * locale; alles Sichtbare kommt aus dem Woerterbuch.
 *
 * Reihenfolge: Header, Hero, Quellen-Ticker, Befund 01 (Markt), Prinzip 02
 * (Haltung), Protokoll 03 (Daten, Navy), Modell 04 (Preis), Anhang 05
 * (Fragen), Beta-CTA (Navy), Footer.
 */
import Base from '../layouts/Base.astro';
import BetaCta from './BetaCta.astro';
import DataSection from './DataSection.astro';
import Faq from './Faq.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Pricing from './Pricing.astro';
import Reveal from './Reveal.astro';
import Stance from './Stance.astro';
import Ticker from './Ticker.astro';
import Tricks from './Tricks.astro';
import { OPERATOR_NAME, SITE_NAME, SITE_URL } from '../config.ts';
import { LOCALE_TAGS, getDictionary, localePath, type Locale } from '../i18n/index.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const ogImage = `/og/${locale}.png`;

const organization = {
  '@type': 'Organization',
  name: OPERATOR_NAME,
  url: SITE_URL,
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: SITE_NAME,
    url: new URL(localePath(locale), SITE_URL).href,
    inLanguage: LOCALE_TAGS[locale],
    description: t.meta.description,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'iOS, Android',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    publisher: organization,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: LOCALE_TAGS[locale],
    mainEntity: t.faq.items.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<Base
  locale={locale}
  title={t.meta.title}
  description={t.meta.description}
  ogImage={ogImage}
  ogAlt={t.meta.ogAlt}
  jsonLd={jsonLd}
>
  <Header locale={locale} />
  <main id="main">
    <span id="top" aria-hidden="true"></span>
    <Hero locale={locale} />
    <Ticker locale={locale} />
    <Tricks locale={locale} />
    <Stance locale={locale} />
    <DataSection locale={locale} />
    <Pricing locale={locale} />
    <Faq locale={locale} />
    <BetaCta locale={locale} />
  </main>
  <Footer locale={locale} />
  <Reveal />
</Base>
