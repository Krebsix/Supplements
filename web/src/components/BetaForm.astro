---
/**
 * Beta-Anmeldung: Border-Box mit Offset-Schatten, POST als JSON an die
 * Supabase Edge Function beta-signup (supabase/functions/beta-signup).
 *
 * Zwei Varianten ueber `onNavy`: hell (Hero, Rahmen Navy, Schatten
 * Navy-Sekundaer) und dunkel (Beta-CTA-Sektion, Rahmen Weiss, Schatten
 * Azur). Auf Erfolg bleibt das Feld sichtbar (deaktiviert), nur der
 * Knopf-Text wechselt zu "Eingetragen ✓" (Design-Vorgabe), plus eine
 * kleine Statuszeile fuer Screenreader.
 *
 * Ohne Endpoint (Env leer) rendert das Formular deaktiviert mit Hinweis
 * statt eines toten Knopfs. Honeypot-Feld "company" ist fuer Menschen
 * unsichtbar; ist es gefuellt, tut das Skript so, als waere gesendet
 * worden, ohne etwas zu senden.
 */
import { BETA_SIGNUP_URL, CONTACT_EMAIL } from '../config.ts';
import { getDictionary, type Locale } from '../i18n/index.ts';

interface Props {
  locale: Locale;
  id: string;
  onNavy?: boolean;
}

const { locale, id, onNavy = false } = Astro.props;
const t = getDictionary(locale);
const enabled = BETA_SIGNUP_URL !== '';
const emailId = `${id}-email`;
const statusId = `${id}-status`;
---

<form
  class:list={['beta-form', { 'beta-form--onnavy': onNavy }]}
  data-beta-form
  data-endpoint={BETA_SIGNUP_URL}
  data-locale={locale}
  data-source={`website-${locale}`}
  data-cta={t.form.cta}
  data-cta-done={t.form.ctaDone}
  data-error={t.form.error}
  data-state="idle"
  novalidate
>
  <div class="beta-form__row">
    <label class="visually-hidden" for={emailId}>{t.form.label}</label>
    <input
      class="input"
      id={emailId}
      type="email"
      name="email"
      inputmode="email"
      autocomplete="email"
      required
      placeholder={t.form.placeholder}
      disabled={!enabled}
    />
    <div class="beta-form__trap" aria-hidden="true">
      <label for={`${id}-company`}>Company</label>
      <input id={`${id}-company`} type="text" name="company" tabindex="-1" autocomplete="off" />
    </div>
    <button class="mono-button beta-form__submit" type="submit" disabled={!enabled} data-cta-label>
      {t.form.cta}
    </button>
  </div>
  <p class="beta-form__status" id={statusId} role="status" aria-live="polite" data-status></p>
  {enabled ? (
    <p class="beta-form__consent">
      {t.form.consentPrefix} → <a href="/datenschutz/#de">{t.form.consentLink}</a>
    </p>
  ) : (
    <p class="beta-form__consent">
      {t.form.pending} <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </p>
  )}
</form>

<style>
  .beta-form {
    max-width: 540px;
  }
  .beta-form__row {
    display: flex;
    border: 1.5px solid var(--navy);
    background: #ffffff;
    box-shadow: 5px 5px 0 var(--navy-soft);
  }
  .beta-form--onnavy .beta-form__row {
    border-color: #ffffff;
    background: var(--navy);
    box-shadow: 5px 5px 0 var(--azur);
  }
  .beta-form--onnavy .input {
    color: #ffffff;
  }
  .beta-form__submit {
    border-left: 1.5px solid var(--navy);
    background: var(--navy-soft);
    color: #ffffff;
    padding: 17px 26px;
  }
  .beta-form__submit:hover:not(:disabled) {
    background: var(--azur);
  }
  .beta-form__submit:disabled {
    cursor: not-allowed;
    opacity: 0.7;
  }
  .beta-form--onnavy .beta-form__submit {
    border-left-color: #ffffff;
    background: var(--azur);
  }
  .beta-form--onnavy .beta-form__submit:hover:not(:disabled) {
    background: var(--azur-hover);
  }
  .beta-form__status {
    margin: 10px 0 0;
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .beta-form__status:empty {
    display: none;
  }
  .beta-form[data-state='error'] .beta-form__status {
    color: var(--status-caution);
  }
  .beta-form--onnavy[data-state='error'] .beta-form__status {
    color: #ffb4a0;
  }
  .beta-form__trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .beta-form__consent {
    margin: 16px 0 0;
    max-width: 520px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    line-height: 1.6;
    color: var(--ink-faint);
  }
  .beta-form--onnavy .beta-form__consent {
    color: var(--onnavy-faintest);
    max-width: 480px;
    margin-inline: auto;
  }
  .beta-form__consent a {
    color: var(--ink-muted);
    text-decoration: underline;
  }
  .beta-form--onnavy .beta-form__consent a {
    color: var(--onnavy-faint);
  }
  .beta-form__consent a:hover {
    color: var(--azur);
  }
  .beta-form--onnavy .beta-form__consent a:hover {
    color: #ffffff;
  }
</style>

<script>
  // Sendet die Anmeldung per fetch an die Edge Function und zeigt die
  // Rueckmeldung im Knopf-Text ("Eingetragen ✓") statt das Feld zu
  // verstecken, wie in der Design-Vorlage.
  const forms = document.querySelectorAll<HTMLFormElement>('form[data-beta-form]');

  forms.forEach((form) => {
    const endpoint = form.dataset.endpoint ?? '';
    if (!endpoint) return;

    const status = form.querySelector<HTMLElement>('[data-status]');
    const ctaLabel = form.querySelector<HTMLElement>('[data-cta-label]');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const email = form.querySelector<HTMLInputElement>('input[name="email"]');
    const trap = form.querySelector<HTMLInputElement>('input[name="company"]');
    if (!status || !ctaLabel || !button || !email) return;

    const ctaIdle = form.dataset.cta ?? '';
    const ctaDone = form.dataset.ctaDone ?? '';

    const setState = (state: 'idle' | 'sending' | 'success' | 'error', message = '') => {
      form.dataset.state = state;
      status.textContent = message;
      button.disabled = state === 'sending' || state === 'success';
      ctaLabel.textContent = state === 'success' ? ctaDone : ctaIdle;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!email.checkValidity()) {
        email.reportValidity();
        return;
      }
      // Honeypot gefuellt: Bot. Still Erfolg zeigen, nichts senden.
      if (trap && trap.value !== '') {
        email.value = '';
        email.disabled = true;
        setState('success');
        return;
      }

      setState('sending');
      const body = JSON.stringify({
        email: email.value.trim(),
        locale: form.dataset.locale ?? 'de',
        source: form.dataset.source ?? 'website',
        company: trap?.value ?? '',
      });

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body,
        });
        const data = (await response.json().catch(() => ({}))) as { ok?: boolean };
        if (response.ok && data.ok) {
          email.disabled = true;
          setState('success');
        } else {
          setState('error', form.dataset.error ?? '');
        }
      } catch {
        setState('error', form.dataset.error ?? '');
      }
    });
  });
</script>
