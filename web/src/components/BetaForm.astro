---
/**
 * Beta-Anmeldung ueber Loops (POST an newsletter-form/<id>, Antwort JSON).
 *
 * Zustaende ueber data-state: idle, sending, success, error. Die Texte
 * kommen aus dem Woerterbuch und liegen als data-Attribute am Formular,
 * damit das Skript sprachunabhaengig bleibt. Ohne Form-ID (Env leer)
 * rendert das Formular deaktiviert mit Hinweis, nie ein toter Knopf.
 *
 * Honeypot: das Feld "company" ist fuer Menschen unsichtbar. Ist es
 * gefuellt, tut das Skript so, als haette es gesendet, und sendet nichts.
 */
import { CONTACT_EMAIL, LOOPS_ENDPOINT } from '../config.ts';
import { getDictionary, type Locale } from '../i18n/index.ts';

interface Props {
  locale: Locale;
  /** Eindeutiges Praefix fuer ids, weil das Formular zweimal auf der Seite steht. */
  id: string;
  /** Kompakt: nur Feld und Knopf (Hero). Sonst mit Titel und Text. */
  compact?: boolean;
}

const { locale, id, compact = false } = Astro.props;
const t = getDictionary(locale);
const enabled = LOOPS_ENDPOINT !== '';
const emailId = `${id}-email`;
const statusId = `${id}-status`;
---

<form
  class:list={['beta-form', { 'beta-form--compact': compact }]}
  data-beta-form
  data-endpoint={LOOPS_ENDPOINT}
  data-source={`website-${locale}`}
  data-sending={t.form.sending}
  data-success={t.form.success}
  data-error={t.form.error}
  data-state="idle"
  method="post"
  action={LOOPS_ENDPOINT || undefined}
  novalidate
>
  {!compact && (
    <div class="beta-form__intro">
      <h3>{t.form.title}</h3>
      <p>{t.form.body}</p>
    </div>
  )}
  <div class="beta-form__row">
    <label class="visually-hidden" for={emailId}>{t.form.label}</label>
    <input
      class="input"
      id={emailId}
      type="email"
      name="email"
      inputmode="email"
      autocomplete="email"
      required
      placeholder={t.form.placeholder}
      disabled={!enabled}
    />
    <div class="beta-form__trap" aria-hidden="true">
      <label for={`${id}-company`}>Company</label>
      <input id={`${id}-company`} type="text" name="company" tabindex="-1" autocomplete="off" />
    </div>
    <button class="button button--primary" type="submit" disabled={!enabled}>
      <span data-cta>{t.form.cta}</span>
    </button>
  </div>
  <p class="beta-form__status" id={statusId} role="status" aria-live="polite" data-status></p>
  {enabled ? (
    <p class="beta-form__consent">{t.form.consent}</p>
  ) : (
    <p class="beta-form__consent">
      {t.form.pending} <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </p>
  )}
  <noscript>
    <p class="beta-form__consent">
      {t.form.noscript} <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </p>
  </noscript>
</form>

<style>
  .beta-form__intro {
    margin-bottom: 20px;
  }
  .beta-form__intro h3 {
    font-size: clamp(22px, 2.4vw, 28px);
    margin-bottom: 8px;
  }
  .beta-form__row {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .beta-form__trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .beta-form__status {
    min-height: 0;
    margin-top: 10px;
    font-size: 15px;
    color: var(--ink);
    font-weight: 500;
  }
  .beta-form__status:empty {
    display: none;
  }
  .beta-form[data-state='error'] .beta-form__status {
    color: var(--alert);
  }
  .beta-form[data-state='success'] .beta-form__status {
    color: var(--affirm);
  }
  .beta-form[data-state='success'] .beta-form__row,
  .beta-form[data-state='success'] .beta-form__consent {
    display: none;
  }
  .beta-form__consent {
    margin-top: 12px;
    font-size: 13px;
    line-height: 18px;
    color: var(--ink-faint);
  }
  @media (min-width: 520px) {
    .beta-form__row {
      flex-direction: row;
    }
    .beta-form__row .input {
      flex: 1 1 auto;
    }
    .beta-form__row .button {
      flex: 0 0 auto;
    }
  }
</style>

<script>
  // Sendet die Anmeldung per fetch an Loops und zeigt die Rueckmeldung
  // inline. Laeuft fuer jedes Formular mit data-beta-form auf der Seite.
  const forms = document.querySelectorAll<HTMLFormElement>('form[data-beta-form]');

  forms.forEach((form) => {
    const endpoint = form.dataset.endpoint ?? '';
    if (!endpoint) return;

    const status = form.querySelector<HTMLElement>('[data-status]');
    const cta = form.querySelector<HTMLElement>('[data-cta]');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const email = form.querySelector<HTMLInputElement>('input[name="email"]');
    const trap = form.querySelector<HTMLInputElement>('input[name="company"]');
    if (!status || !cta || !button || !email) return;

    const ctaLabel = cta.textContent ?? '';

    const setState = (state: 'idle' | 'sending' | 'success' | 'error', message = '') => {
      form.dataset.state = state;
      status.textContent = message;
      button.disabled = state === 'sending';
      cta.textContent = state === 'sending' ? (form.dataset.sending ?? ctaLabel) : ctaLabel;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!email.checkValidity()) {
        email.reportValidity();
        return;
      }
      // Honeypot gefuellt: Bot. Still "Erfolg" zeigen, nichts senden.
      if (trap && trap.value !== '') {
        setState('success', form.dataset.success ?? '');
        return;
      }

      setState('sending');
      const body = new URLSearchParams({
        email: email.value.trim(),
        userGroup: 'beta',
        source: form.dataset.source ?? 'website',
      });

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body,
        });
        const data = (await response.json().catch(() => ({}))) as { success?: boolean };
        if (response.ok && data.success) {
          setState('success', form.dataset.success ?? '');
        } else {
          setState('error', form.dataset.error ?? '');
        }
      } catch {
        setState('error', form.dataset.error ?? '');
      }
    });
  });
</script>
