---
/**
 * Was die App nicht tut. Bewusst prominent: bei einer Gesundheits-App ist
 * das der Vertrauensbeweis.
 */
import Icon from './Icon.astro';
import Section from './Section.astro';
import { getDictionary, type Locale } from '../i18n/index.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

<Section id="limits" eyebrow={t.notList.eyebrow} title={t.notList.title}>
  <ul class="card card--xl notlist">
    {t.notList.items.map((item) => (
      <li>
        <span class="notlist__icon">
          <Icon name="slash" />
        </span>
        <span>{item}</span>
      </li>
    ))}
  </ul>
</Section>

<style>
  .notlist {
    display: grid;
    gap: 0;
  }
  .notlist li {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 0;
    border-top: 1px solid var(--rule);
    color: var(--ink);
    font-size: clamp(17px, 1.5vw, 20px);
    font-weight: 500;
  }
  .notlist li:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .notlist li:last-child {
    padding-bottom: 0;
  }
  .notlist__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: var(--alert-soft);
    color: var(--alert);
    flex: 0 0 auto;
  }
</style>
