---
/**
 * Modell 04: drei Spalten als Hairline-Grid. Kostenlos (weiss), Pro
 * (Navy-Sekundaer), Transparenz-Begruendung (weiss). Keine Preiszahlen.
 */
import Section from './Section.astro';
import { getDictionary, type Locale } from '../i18n/index.ts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDictionary(locale);
---

<Section id="pricing" tag={t.pricing.tag} context={t.pricing.context} title={t.pricing.title}>
  <div class="grid" data-reveal="1">
    <div class="col col--light">
      <div class="col__tag col__tag--muted">{t.pricing.freeTag}</div>
      <h3>{t.pricing.freeTitle}</h3>
      <ul>
        {t.pricing.freeItems.map((item) => (
          <li><span class="check check--azur">✓</span> {item}</li>
        ))}
      </ul>
    </div>
    <div class="col col--navy">
      <div class="col__tag col__tag--onnavy">{t.pricing.proTag}</div>
      <h3>{t.pricing.proTitle}</h3>
      <ul>
        {t.pricing.proItems.map((item) => (
          <li><span class="check check--onnavy">✓</span> {item}</li>
        ))}
      </ul>
    </div>
    <div class="col col--light">
      <div class="col__tag col__tag--muted">{t.pricing.whyTag}</div>
      <h3>{t.pricing.whyTitle}</h3>
      <p>{t.pricing.whyBody}</p>
    </div>
  </div>
</Section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    border: 1.5px solid var(--navy);
    background: var(--navy);
    gap: 1.5px;
  }
  .col {
    padding: 44px 38px;
  }
  .col--light {
    background: #ffffff;
  }
  .col--navy {
    background: var(--navy-soft);
    color: #ffffff;
  }
  .col__tag {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  .col__tag--muted {
    color: var(--ink-faint);
  }
  .col__tag--onnavy {
    color: var(--azur-onnavy);
  }
  .col h3 {
    margin: 0 0 22px;
    font-size: 24px;
  }
  .col ul {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .col--light li {
    display: flex;
    gap: 10px;
    font-size: 15px;
    color: var(--ink-muted);
  }
  .col--navy li {
    display: flex;
    gap: 10px;
    font-size: 15px;
    color: var(--onnavy-muted);
  }
  .check {
    font-family: var(--font-mono);
  }
  .check--azur {
    color: var(--azur);
  }
  .check--onnavy {
    color: var(--azur-onnavy);
  }
  .col--light p {
    margin: 0;
    font-size: 15px;
    line-height: 1.65;
    color: var(--ink-muted);
    text-wrap: pretty;
  }
  @media (min-width: 900px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
