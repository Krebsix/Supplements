---
/**
 * Sektions-Header: Mono-Label links, gestrichelte Linie, Kontext-Label
 * rechts, darunter die Ueberschrift. `onNavy` schaltet die Farben fuer
 * dunkle Sektionen um.
 */
interface Props {
  id?: string;
  tag: string;
  context: string;
  title: string;
  onNavy?: boolean;
  class?: string;
}
const { id, tag, context, title, onNavy = false, class: className } = Astro.props;
---

<section class:list={['section', className]} id={id} style={onNavy ? 'background:var(--navy);color:#fff' : undefined}>
  <div class="container">
    <div class:list={['section-head', { 'section-head--onnavy': onNavy }]} data-reveal="1">
      <span class="eyebrow">{tag}</span>
      <span class="section-head__rule"></span>
      <span class="section-head__context">{context}</span>
    </div>
    <h2 class="section-title" data-reveal="1">{title}</h2>
    <slot />
  </div>
</section>
