---
/**
 * Protokoll 03: Navy-Sektion. Links Fliesstext plus Fakten-Tabelle,
 * rechts die weisse Bericht-Karte (Offset-Schatten) und die gestrichelte
 * "Klare Grenzen"-Karte.
 */
import Section from './Section.astro';
import { getDictionary, type Locale } from '../i18n/index.ts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDictionary(locale);
---

<Section id="data" tag={t.data.tag} context={t.data.context} title={t.data.title} onNavy>
  <div class="grid" data-reveal="1">
    <div class="text">
      {t.data.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      <div class="facts">
        {t.data.facts.map((fact) => (
          <div class="facts__row">
            <span class="facts__key">{fact.key}</span>
            <span class="facts__value">{fact.value}</span>
          </div>
        ))}
      </div>
    </div>
    <div class="cards">
      <div class="report-card">
        <div class="report-card__tag">{t.data.reportTag}</div>
        <h3>{t.data.reportTitle}</h3>
        <p>{t.data.reportBody}</p>
        <ul>
          {t.data.reportItems.map((item) => (
            <li><span class="report-card__check">✓</span> {item}</li>
          ))}
        </ul>
      </div>
      <div class="limits-card">
        <div class="limits-card__tag">{t.data.limitsTag}</div>
        <h3>{t.data.limitsTitle}</h3>
        <ul>
          {t.data.limitsItems.map((item) => (
            <li><span class="limits-card__cross">✕</span> {item}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</Section>

<style>
  .grid {
    display: grid;
    gap: 56px;
    align-items: start;
  }
  .text p {
    margin: 0 0 16px;
    font-size: 17px;
    line-height: 1.65;
    color: var(--onnavy-muted);
    text-wrap: pretty;
  }
  .facts {
    margin-top: 32px;
    border: 1px solid var(--rule-onnavy);
  }
  .facts__row {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 16px 22px;
    border-bottom: 1px solid var(--rule-onnavy-soft);
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .facts__row:last-child {
    border-bottom: none;
  }
  .facts__key {
    color: var(--onnavy-faintest);
  }
  .facts__value {
    color: #ffffff;
    font-weight: 600;
    text-align: right;
  }
  .cards {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .report-card,
  .limits-card {
    padding: 36px;
  }
  .report-card {
    background: #ffffff;
    color: var(--ink);
    box-shadow: 6px 6px 0 var(--azur);
  }
  .report-card__tag {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--azur);
    margin-bottom: 14px;
  }
  .report-card h3 {
    margin: 0 0 12px;
    font-size: 25px;
    letter-spacing: -0.015em;
  }
  .report-card p {
    margin: 0 0 18px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-muted);
    text-wrap: pretty;
  }
  .report-card ul,
  .limits-card ul {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .report-card li {
    display: flex;
    gap: 10px;
    font-size: 14.5px;
    font-weight: 600;
  }
  .report-card__check {
    color: var(--azur);
    font-family: var(--font-mono);
  }
  .limits-card {
    border: 1px dashed rgba(255, 255, 255, 0.4);
  }
  .limits-card__tag {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--azur-onnavy);
    margin-bottom: 14px;
  }
  .limits-card h3 {
    margin: 0 0 16px;
    font-size: 25px;
    letter-spacing: -0.015em;
    color: #ffffff;
  }
  .limits-card li {
    display: flex;
    gap: 10px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--onnavy-muted);
  }
  .limits-card__cross {
    color: var(--azur-onnavy);
    font-family: var(--font-mono);
  }
  @media (min-width: 900px) {
    .grid {
      grid-template-columns: 1.15fr 1fr;
    }
  }
</style>
